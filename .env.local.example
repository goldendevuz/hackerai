# =============================================================================
# AUTHENTICATION - WorkOS (Required)
# =============================================================================
# Sign up at: https://workos.com/
WORKOS_API_KEY=sk_example_123456789

# ⚠️ IMPORTANT: Also add this to Convex Dashboard → Environment Variables
WORKOS_CLIENT_ID=client_123456789

# ⚠️ IMPORTANT: Also add this to Convex Dashboard → Environment Variables
# Use api.workos.com unless WorkOS has configured a custom Authentication API domain.
WORKOS_AUTH_DOMAIN=api.workos.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Server-only HMAC key for privacy-preserving free quota identity hashes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCOUNT_IDENTITY_HMAC_SECRET=

# WorkOS Dashboard → Webhooks → Endpoint signing secret
WORKOS_WEBHOOK_SECRET=

# Server-only secret from Intercom → Settings → Workspace → Security → Messenger.
# Used to sign short-lived JWTs for workspace wjc8uwt3. Never expose this as NEXT_PUBLIC_*.
INTERCOM_MESSENGER_SECRET=

# =============================================================================
# CONVEX DATABASE (Required)
# =============================================================================
# Run `npx convex dev` first to generate these values
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ IMPORTANT: Also add this to Convex Dashboard → Environment Variables
CONVEX_SERVICE_ROLE_KEY="replace-with-a-32+char-random-secret"

# Dedicated credential for the restricted PM user-research Trigger task.
# Generate a different value for each environment and configure the matching
# value in both Convex and Trigger.dev. Never expose it to PMs or browsers.
CONVEX_USER_RESEARCH_SERVICE_KEY="replace-with-a-different-32+char-random-secret"

# For local Convex deployment, use `pnpm run dev:local` instead of `pnpm run dev`
# See: https://docs.convex.dev/cli/local-deployments

# =============================================================================
# FILE STORAGE (Required)
# =============================================================================
# Solider.uz Phase 1 ($0 budget): Cloudflare R2 instead of paid AWS S3.
# R2 free tier = 10GB storage + 1M write / 10M read ops per month, zero
# egress fees, permanent (not time-limited like AWS's post-2025 Free Plan).
# Fully S3-API-compatible — no other app code changes needed.
# Create a bucket + R2 API token at: https://dash.cloudflare.com/ -> R2
# ⚠️ IMPORTANT: Also add these to Convex Dashboard → Environment Variables
# and Trigger.dev → Environment Variables.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Legacy AWS S3 path (kept for a possible Phase 2 / paid rebuild) ---
# Leave STORAGE_PROVIDER unset (or set it to anything other than "r2") and
# fill these in instead to use AWS S3. Note: AWS no longer gives new accounts
# (created after 2025-07-15) a permanent free tier — only a 6-month/$200
# credit "Free Plan". See https://aws.amazon.com/s3/
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# Regional storage rollout. Keep false until the matching bucket names and IAM
# access are configured in both Convex and Trigger.dev for this environment.
S3_REGIONAL_STORAGE_ENABLED=false
AWS_S3_BUCKET_NAME_EU_CENTRAL_1=
AWS_S3_BUCKET_NAME_US_EAST_1=
AWS_S3_BUCKET_NAME_US_WEST_2=

# Optional S3 configuration (defaults shown, uncomment to override)
# S3_URL_LIFETIME_SECONDS=3600
# S3_URL_EXPIRATION_BUFFER_SECONDS=300

# =============================================================================
# AI PROVIDERS
# =============================================================================
# OpenRouter - Get key at: https://openrouter.ai/
OPENROUTER_API_KEY=
# Optional last-resort fallback chain: when OpenRouter refuses a request
# (402/429/503 or a key-limit 403), it is replayed on these OpenAI-compatible
# providers in this order, using each one whose key is set. Text-only requests.
# A key variable may hold several comma-separated keys from separate accounts;
# they are rotated and a rate-limited key is skipped for a while. Also set them
# on the Trigger.dev worker environment, where Agent runs execute.
# Privacy: Mistral's Experiment tier and Google AI Studio's free tier may train
# on prompts. Leave their keys unset, or list only the providers you accept in
# FALLBACK_PROVIDER_ORDER (e.g. groq,cerebras,sambanova,huggingface,nvidia).
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
# FALLBACK_PROVIDER_ORDER=groq,cerebras,sambanova,huggingface,nvidia,mistral,google
# <PROVIDER>_FALLBACK_MODEL overrides a default, e.g. GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Solider.uz Phase 1: intentionally left UNSET ---
# OPENAI_API_KEY + ABLITERATION_API_KEY together route eligible requests to
# a safety-training-removed ("abliterated") model once OpenAI's moderation
# endpoint scores a message as low-risk (see lib/moderation.ts and
# lib/ai/abliteration.ts upstream). Both files already no-op cleanly when
# these keys are absent -- the app just uses its standard, safety-trained
# models for everything. That's the deliberate choice for a THM/HTB/
# PortSwigger lab-assistant: no mechanism designed to get around a model's
# own safety refusals. It also happens to remove the one required-but-not-
# free account from the upstream README (OpenAI has had no standing free
# trial credit for new accounts since mid-2025).
# OPENAI_API_KEY=
# ABLITERATION_API_KEY=

# =============================================================================
# CODE EXECUTION - CLOUD SANDBOX (Required for cloud Agent Mode)
# =============================================================================
E2B_API_KEY=
E2B_TEMPLATE=terminal-agent-sandbox
# Required for European cloud Agent execution. EU runs discover, reconnect,
# and create only in this cluster; they fail closed when its key is absent.
# E2B_EU_API_KEY=
# E2B_EU_DOMAIN=e2b-juliett.dev
# E2B_EU_TEMPLATE=terminal-agent-sandbox

# =============================================================================
# WEB SEARCH & SCRAPING (Optional)
# =============================================================================
# Web Search API - https://docs.perplexity.ai/guides/search-quickstart
# PERPLEXITY_API_KEY=

# Jina AI - URL content extraction: https://jina.ai/reader
# JINA_API_KEY=

# =============================================================================
# REDIS (Optional - for stream resumption)
# =============================================================================
# ⚠️ IMPORTANT: Also add this to Convex Dashboard → Environment Variables
# REDIS_URL=redis://localhost:6379

# =============================================================================
# RATE LIMITING (Optional)
# =============================================================================
# Sign up at: https://upstash.com/
# UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Cross-tab token sharing - coordinates auth token refresh across browser tabs
# to prevent WorkOS rate limits. Value is rollout percentage (0-100).
# NEXT_PUBLIC_FF_CROSS_TAB_TOKEN_SHARING=0

# Development-only auto-compaction threshold override.
# NEXT_PUBLIC_DEV_SUMMARIZATION_THRESHOLD_TOKENS=12000

# =============================================================================
# REFERRALS (Optional)
# =============================================================================
# REFERRAL_PROGRAM_ENABLED=true
# REFERRAL_REFERRER_REWARD_DOLLARS=10
# REFERRAL_REFERRED_SIGNUP_BONUS_UNITS=10
# REFERRAL_ATTRIBUTION_MAX_USER_AGE_DAYS=7
# REFERRAL_COOKIE_MAX_AGE_DAYS=30

# =============================================================================
# ANALYTICS & OBSERVABILITY (Optional - PostHog)
# =============================================================================
# Sign up at: https://posthog.com/
# Used for product analytics, tool-call events, and server error tracking.
# NEXT_PUBLIC_POSTHOG_KEY=phc_
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# Required in CI/production builds to upload source maps for readable stack traces.
# Personal API key with the Source map upload preset.
# POSTHOG_CLI_API_KEY=phx_
# POSTHOG_CLI_PROJECT_ID=
# POSTHOG_CLI_HOST=https://us.posthog.com

# =============================================================================
# PLATFORM COST SYNC (Optional - Vercel Cron -> Convex -> PostHog Warehouse)
# =============================================================================
# Shared secret automatically sent by Vercel Cron as a Bearer token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=
# Team-scoped Vercel access token with read access to billing charges.
# VERCEL_BILLING_READ_TOKEN=
# Vercel team id whose FOCUS billing charges should be reconciled daily.
# VERCEL_BILLING_TEAM_ID=
# Canonical Convex deployment URL used by the authenticated usage API.
# Custom application domains do not expose this admin endpoint.
# CONVEX_DEPLOYMENT_URL=https://your-deployment.convex.cloud
# CONVEX_DEPLOY_KEY and CONVEX_SERVICE_ROLE_KEY reuse existing app configuration.

# Protects /api/health/core, which checks the WorkOS dependency for uptime monitoring.
# Add the same value as the x-hackerai-health-token header in the uptime monitor.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CORE_HEALTH_CHECK_TOKEN=

# =============================================================================
# PAYMENTS (Optional - Stripe)
# =============================================================================
# Sign up at: https://stripe.com/
# ⚠️ IMPORTANT: If using Stripe, also add these to Convex Dashboard → Environment Variables
# STRIPE_API_KEY=sk_test_
# STRIPE_EXTRA_USAGE_WEBHOOK_SECRET=
# STRIPE_FRAUD_WEBHOOK_SECRET=
# STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
# Separate influencer commission webhook (web application only)
# STRIPE_INFLUENCER_WEBHOOK_SECRET=

# =============================================================================
# BASE URL (Required)
# =============================================================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =============================================================================
# CENTRIFUGO (Real-time sandbox relay)
# =============================================================================
CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket

# =============================================================================
# TRIGGER.DEV (Required for "Agent Long" mode)
# =============================================================================
# Sign up at: https://trigger.dev/  →  API Keys page  →  copy `tr_dev_…`.
# Task-side env vars live in the Trigger.dev dashboard, not here.
TRIGGER_PROJECT_ID=proj_
TRIGGER_SECRET_KEY=tr_dev_

# Production-only narrow PM user-research gateway. Store only the SHA-256 digest
# of the PM's scoped runner key on the server; the PM stores the plaintext key
# in its Codex environment. Never reuse a Trigger or Convex credential here.
# Generate one key: export HACKERAI_PM_USER_RESEARCH_KEY="$(openssl rand -hex 32)"
# Hash that exact key for Vercel:
# printf '%s' "$HACKERAI_PM_USER_RESEARCH_KEY" | shasum -a 256 | awk '{print $1}'
# Store the unchanged plaintext only in the PM's Codex environment.
# PM_USER_RESEARCH_RUNNER_KEY_SHA256=
